# ---------------------------------------------------------------------------
# Byte-compiled / optimized
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv*/
env/
.env
.envrc

# ---------------------------------------------------------------------------
# Distribution / packaging
# ---------------------------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# Type checkers / linters / coverage
# ---------------------------------------------------------------------------
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# OS / IDE
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Model weights and large binaries - DO NOT COMMIT
# ---------------------------------------------------------------------------
*.h5
*.pt
*.pth
*.onnx
*.tflite
*.pb
*.ckpt
*.safetensors
# Anchor ``models/`` to the repo root so the trained-model output folder
# is ignored but the ``src/tooth_resorption/models/`` Python package
# (which contains model.py / architectures.py / __init__.py) remains
# tracked. The previous un-anchored ``models/`` pattern matched the
# package directory recursively and caused CI to checkout the package
# without its source files, leading to mypy ``Cannot find implementation
# or library stub for module named "tooth_resorption.models.model"``.
/models/
/checkpoints/
deployment/onnx/
deployment/torchscript/
deployment/quantized/

# ---------------------------------------------------------------------------
# Real and generated data - DO NOT COMMIT
# ---------------------------------------------------------------------------
data/raw/
data/processed/
data/interim/
data/synthetic/
data/clinical/
data/labelme/

# ---------------------------------------------------------------------------
# Patient data (KVKK / GDPR / IRB) - never commit. Both the historical
# Turkish folder name and the new English path are explicitly excluded.
# ---------------------------------------------------------------------------
/20 lik diş rezorpsiyon/
/20-lik-dis-rezorpsiyon/
**/20 lik diş rezorpsiyon/
**/labelme_dataset/
**/hasta_*/
**/patient_*/

# Reverse lookup from anonymised IDs to patient names - must never leave
# the local workstation. Re-generated on demand by scripts/anonymize_dataset.py.
**/anonymization_map.json

# ---------------------------------------------------------------------------
# Medical imaging raw formats
# ---------------------------------------------------------------------------
*.dcm
*.dicom
*.nii
*.nii.gz

# ---------------------------------------------------------------------------
# Training artifacts / experiment trackers
# ---------------------------------------------------------------------------
*.log
runs/
mlruns/
wandb/
lightning_logs/
tb_logs/

# ---------------------------------------------------------------------------
# Plots produced by smoke runs (only the published ones are versioned)
# ---------------------------------------------------------------------------
results/metrics_synthetic.json
results/evaluation_synthetic.json
results/training_history_*.json
results/classification_report_*.txt
results/plots/synthetic_*.png
results/plots/confusion_matrix*.png
results/plots/roc_*.png
results/plots/pr_*.png
